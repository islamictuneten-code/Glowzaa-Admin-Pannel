rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is Admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ['rakibseohub@gmail.com', 'admin@glowzaa.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Helper function to check if user is Sales
    function isSales() {
      return isAuthenticated() && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'sales');
    }

    // Helper function to check if user is Delivery
    function isDelivery() {
      return isAuthenticated() && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'delivery');
    }

    // Users Collection rules: Allow public read so staff can resolve loginId/phone to authEmail prior to sign-in; Admin can create/update/delete any user; Root admin can self-provision; Non-admins can self-register ONLY with non-privileged roles and CANNOT inject privileged RBAC fields or edit roles/permissions.
    match /users/{userId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isOwner(userId) && 
        request.auth.token.email in ['admin@glowzaa.com', 'rakibseohub@gmail.com']
      ) || (
        isOwner(userId) && 
        !(request.resource.data.role in ['admin', 'sales', 'delivery', 'manager', 'supervisor', 'staff', 'cashier', 'operator', 'executive', 'superuser', 'driver', 'warehouse']) &&
        (!('role' in request.resource.data) || request.resource.data.role in ['customer', 'guest', 'viewer', 'user']) &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
        (!('permissions' in request.resource.data) || request.resource.data.permissions.size() == 0) &&
        !request.resource.data.keys().hasAny([
          'staffId', 'salesStaffId', 'deliveryStaffId', 'monthlyTarget', 
          'commissionRate', 'department', 'territory', 'assignedArea', 
          'assignedZones', 'vehicleNumber', 'vehicleType', 'createdBy', 
          'createdByName', 'salary', 'creditLimit', 'advanceBalance', 
          'totalPurchase', 'totalPaid', 'currentDue'
        ])
      );
      allow update: if isAdmin() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'permissions', 'isAdmin', 'status', 'loginId', 
          'staffId', 'salesStaffId', 'deliveryStaffId', 'monthlyTarget', 
          'commissionRate', 'department', 'territory', 'assignedArea', 
          'assignedZones', 'vehicleNumber', 'vehicleType', 'createdBy', 
          'createdByName', 'salary', 'creditLimit', 'advanceBalance', 
          'totalPurchase', 'totalPaid', 'currentDue'
        ])
      );
      allow delete: if isAdmin();
    }

    // Audit Logs Collection rules: Immutable administrative & security event logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Categories Collection rules: Any authenticated user can read; only Admin can create/edit/delete
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Products Collection rules: Any authenticated user can read; only Admin can create/edit/delete/adjust
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Inventory Transactions Collection rules: Any authenticated user can read; authenticated users performing transactions can create
    match /inventoryTransactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Customers Collection rules: All authenticated staff can read; Admin and Sales can create/update; Delivery can ONLY update payment balance fields; Only Admin can delete or modify credit policy fields
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isSales();
      allow update: if isAdmin() || (
        (isSales() || isDelivery()) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'creditLimit', 'creditCheckMode', 'creditHold', 'creditHoldReason', 
          'creditReviewDate', 'creditNote', 'riskLevel'
        ])
      ) || (
        isAuthenticated() && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'creditLimit', 'creditCheckMode', 'creditHold', 'creditHoldReason', 
          'creditReviewDate', 'creditNote', 'riskLevel',
          'shopName', 'ownerName', 'phone', 'alternatePhone', 
          'email', 'address', 'area', 'city', 'district', 'notes', 
          'assignedSalesUserId', 'assignedSalesUserName', 'totalPurchase', 
          'totalReturned', 'paymentTermDays', 'status', 'tradeLicenseNo'
        ])
      );
      allow delete: if isAdmin();
    }

    // Customer Notes Collection rules: Internal collaboration notes for sales and admin
    match /customer_notes/{noteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isAdmin() || isSales() || request.resource.data.createdBy == request.auth.uid
      );
      allow update: if isAdmin() || (
        isAuthenticated() && resource.data.createdBy == request.auth.uid
      );
      allow delete: if isAdmin() || (
        isAuthenticated() && resource.data.createdBy == request.auth.uid
      );
    }

    // Orders Collection rules: All authenticated staff can read; authenticated staff can create; Admin full update; Sales update own orders; Delivery update assigned orders (items, deliveryStatus, orderStatus, POD & payment status allowed)
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (
        isSales() && 
        (resource.data.salesUserId == request.auth.uid || resource.data.createdBy == request.auth.uid || !('salesUserId' in resource.data) || resource.data.salesUserId == '') &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['salesUserId']) &&
        (
          (resource.data.orderStatus in ['draft', 'pending', 'Draft', 'Pending']) ||
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['grandTotal', 'subtotal', 'totalDiscount', 'discount', 'totalAmount', 'items'])
        )
      ) || (
        (isDelivery() || isAuthenticated()) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'grandTotal', 'subtotal', 'totalDiscount', 'discount', 'totalAmount', 
          'stockDeducted', 'stockRestored', 'salesUserId', 'customerId', 
          'shopName', 'ownerName'
        ])
      );
      allow delete: if isAdmin();
    }

    // Payments Collection rules: All authenticated staff can read; Admin, Sales, and Delivery can record legitimate payments; Strict field-injection & manipulation protection; Only courier can initiate handover status on own un-reconciled receipts; Reversals & modifications strictly restricted to Admin.
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isAdmin() || 
        isSales() ||
        isDelivery() ||
        (
          request.resource.data.collectedByUserId == request.auth.uid &&
          (!('createdBy' in request.resource.data) || request.resource.data.createdBy == request.auth.uid) &&
          request.resource.data.amount is number &&
          request.resource.data.amount > 0 &&
          request.resource.data.reconciledWithAdmin == false &&
          request.resource.data.isReversed == false
        )
      );
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (
          (resource.data.collectedByUserId == request.auth.uid || resource.data.driverId == request.auth.uid) &&
          resource.data.reconciledWithAdmin != true &&
          resource.data.isReversed != true &&
          resource.data.handoverStatus in ['none', 'rejected', null] &&
          request.resource.data.handoverStatus == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handoverStatus', 'handoverId', 'updatedAt'])
        )
      );
      allow delete: if isAdmin();
    }

    // Customer Ledger Collection rules: All authenticated staff can read; authenticated users can append ledger entries; Admin can update/delete
    match /customerLedger/{ledgerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Delivery History Collection rules: All authenticated staff can read; authenticated users can append history entries; Admin can update/delete
    match /deliveryHistory/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Cash Handovers Collection rules: All authenticated staff can read; delivery couriers can create handover requests; Admin/HQ Cashier can review/accept/reject
    match /cash_handovers/{handoverId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || isDelivery() || request.resource.data.driverId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Expenses Collection rules: All authenticated staff can read; staff can create expense claims; Admin can update/approve/delete; Staff can only edit own pending expenses
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (
        isAuthenticated() && 
        request.resource.data.status == 'pending' && 
        request.resource.data.spentByUserId == request.auth.uid && 
        (!('approvedByUserId' in request.resource.data) || request.resource.data.approvedByUserId == null) && 
        (!('approvedByUserName' in request.resource.data) || request.resource.data.approvedByUserName == null) && 
        (!('approvedAt' in request.resource.data) || request.resource.data.approvedAt == null) && 
        (!('deleted' in request.resource.data) || request.resource.data.deleted == false) && 
        (!('deletedByUserId' in request.resource.data) || request.resource.data.deletedByUserId == null) && 
        (!('deletedAt' in request.resource.data) || request.resource.data.deletedAt == null)
      );
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.spentByUserId == request.auth.uid && 
        resource.data.status == 'pending' && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 'approvedByUserId', 'approvedByUserName', 'approvedAt', 'rejectionReason',
          'spentByUserId', 'deleted', 'deletedAt', 'deletedByUserId'
        ])
      );
      allow delete: if isAdmin();
    }


    // Settings Collection rules: Only Admins can edit company settings, all authenticated staff can read
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Payroll & HR Collections rules: Authenticated staff can read payroll records (payslips, salary structures, payment logs); Admin has full write access
    match /staffSalaryProfiles/{profileId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /monthlyPayrolls/{payrollId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /salaryPayments/{paymentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /staffLoans/{loanId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /payrollAdjustments/{adjId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ========================================================================
    // FIELD SALES TRACKING SYSTEM COLLECTIONS (STEP 14)
    // ========================================================================

    // Field Duty Sessions: All authenticated staff can read; Sales staff & Admin can create and update sessions
    match /field_duty_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || isSales() || request.resource.data.userId == request.auth.uid) && request.resource.data.status == 'active';
      allow update: if isAuthenticated() && (
        isAdmin() || (
          resource.data.userId == request.auth.uid && 
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.sessionId == resource.data.sessionId
        )
      );
      allow delete: if isAdmin();
    }

    // Field Location Pings: All authenticated staff can read; Sales staff & Admin can create their location pings; Pings cannot be updated or deleted by staff
    match /field_location_pings/{pingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isAdmin() || (
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.latitude >= -90.0 && request.resource.data.latitude <= 90.0 &&
          request.resource.data.longitude >= -180.0 && request.resource.data.longitude <= 180.0 &&
          request.resource.data.accuracy >= 0.0
        )
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Customer Visits: All authenticated staff can read visits; Sales staff & Admin can create and update their visits; Ownership fields are immutable
    match /customer_visits/{visitId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || isSales() || request.resource.data.userId == request.auth.uid);
      allow update: if isAuthenticated() && (
        isAdmin() || (
          resource.data.userId == request.auth.uid && 
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.sessionId == resource.data.sessionId &&
          request.resource.data.customerId == resource.data.customerId
        )
      );
      allow delete: if isAdmin();
    }

    // ========================================================================
    // FIREBASE PUSH NOTIFICATION & STAFF COMMUNICATION SYSTEM (STEP 15)
    // ========================================================================

    // Communication Devices: Admin can read all; Users can read, create, and update their own device records
    match /communication_devices/{deviceId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow update: if isAuthenticated() && (
        isAdmin() || (
          resource.data.userId == request.auth.uid && 
          request.resource.data.userId == resource.data.userId
        )
      );
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // Communication Notifications: Read for recipients, sender, or broadcast; Admin full access; Recipient can update read status
    match /communication_notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.recipientUserId == request.auth.uid || 
        resource.data.recipientUserId == 'all' || 
        resource.data.recipientRole == 'all' || 
        resource.data.recipientRole == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role ||
        resource.data.recipientUserId == ('role:' + get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role) ||
        resource.data.senderUserId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        isAdmin() || 
        request.resource.data.senderUserId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isAdmin() || (
          (
            resource.data.recipientUserId == request.auth.uid || 
            resource.data.recipientUserId == 'all' || 
            resource.data.recipientRole == 'all' || 
            resource.data.recipientRole == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role ||
            resource.data.recipientUserId == ('role:' + get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role)
          ) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'senderUserId', 'senderName', 'senderRole', 'recipientUserId', 'recipientRole',
            'title', 'body', 'type', 'priority', 'actionType', 'createdAt'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    // Staff Push Tokens: Legacy compatibility
    match /staff_push_tokens/{tokenId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow update: if isAuthenticated() && (
        isAdmin() || (
          resource.data.userId == request.auth.uid && 
          request.resource.data.userId == resource.data.userId
        )
      );
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // Staff Notifications: Legacy compatibility
    match /staff_notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.recipientUserId == request.auth.uid || 
        resource.data.recipientUserId == 'all' || 
        resource.data.recipientUserId == ('role:' + get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role) ||
        resource.data.senderUserId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        isAdmin() || 
        request.resource.data.senderUserId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isAdmin() || (
          (
            resource.data.recipientUserId == request.auth.uid || 
            resource.data.recipientUserId == 'all' || 
            resource.data.recipientUserId == ('role:' + get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role)
          ) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'senderUserId', 'senderUserName', 'senderRole', 'recipientUserId', 
            'title', 'message', 'type', 'priority', 'createdAt'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    // ========================================================================
    // STEP 15 - PHASE 2: PRIVATE REAL-TIME TEXT MESSAGING SYSTEM RULES
    // ========================================================================

    // Private Conversations: Admin can access all; Staff can only access conversations they participate in
    match /communication_conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.participantIds != null && request.auth.uid in resource.data.participantIds)
      );
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (request.resource.data.participantIds != null && request.auth.uid in request.resource.data.participantIds)
      );
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.participantIds != null && request.auth.uid in resource.data.participantIds)
      );
      allow delete: if isAdmin();
    }

    // Private Messages: Sender or Receiver participant isolation; Staff cannot spoof senderId; Staff cannot delete
    match /communication_messages/{messageId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        isAdmin() || 
        request.resource.data.senderId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isAdmin() || (
          (resource.data.receiverId == request.auth.uid || resource.data.senderId == request.auth.uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'conversationId', 'senderId', 'senderRole', 'receiverId', 'sentAt'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    // ========================================================================
    // STEP 15 - PHASE 3: PREMIUM REAL-TIME VOICE CALLING SYSTEM RULES
    // ========================================================================
    
    match /communication_calls/{callId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.callerId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      );
      
      allow create: if isAuthenticated() && (
        isAdmin() || 
        request.resource.data.callerId == request.auth.uid
      );
      
      allow update: if isAuthenticated() && (
        isAdmin() || (
          (resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'callerId', 'receiverId', 'createdAt'
          ])
        )
      );
      
      allow delete: if isAdmin();
      
      match /signals/{signalId} {
        allow read: if isAuthenticated() && (
          isAdmin() || 
          get(/databases/$(database)/documents/communication_calls/$(callId)).data.callerId == request.auth.uid ||
          get(/databases/$(database)/documents/communication_calls/$(callId)).data.receiverId == request.auth.uid
        );
        
        allow create: if isAuthenticated() && (
          isAdmin() || (
            request.resource.data.senderId == request.auth.uid && (
              get(/databases/$(database)/documents/communication_calls/$(callId)).data.callerId == request.auth.uid ||
              get(/databases/$(database)/documents/communication_calls/$(callId)).data.receiverId == request.auth.uid
            )
          )
        );
        
        allow update: if false; // Signals should be immutable once created
        allow delete: if isAdmin();
      }
    }

    // ========================================================================
    // STEP 15 - PHASE 4: ADVANCED VOICE CALL & GROUP COMMUNICATION RULES
    // ========================================================================
    
    match /communication_group_calls/{callId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        request.auth.uid in resource.data.participantIds
      );
      
      allow create: if isAuthenticated() && isAdmin();
      
      allow update: if isAuthenticated() && (
        isAdmin() || 
        // Participants can only update their own status within the participants map
        (request.auth.uid in resource.data.participantIds)
      );
      
      allow delete: if isAdmin();
      
      match /signals/{signalId} {
        allow read: if isAuthenticated() && (
          isAdmin() || 
          request.auth.uid in get(/databases/$(database)/documents/communication_group_calls/$(callId)).data.participantIds
        );
        allow create: if isAuthenticated() && (
          isAdmin() || 
          (request.resource.data.senderId == request.auth.uid && request.auth.uid in get(/databases/$(database)/documents/communication_group_calls/$(callId)).data.participantIds)
        );
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
    
    match /communication_announcements/{announcementId} {
      allow read: if isAuthenticated(); // All authenticated users can read announcements (filters applied in UI/queries)
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    match /communication_call_queue/{queueId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.callerId == request.auth.uid || resource.data.targetId == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.callerId == request.auth.uid);
      allow update: if isAuthenticated() && (isAdmin() || resource.data.callerId == request.auth.uid || resource.data.targetId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ========================================================================
    // STEP 17.1 & 17.2 & 17.3 — SMART PURCHASE, SUPPLIER MANAGEMENT & GOODS RECEIPT RULES
    // ========================================================================

    match /suppliers/{supplierId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isAuthenticated();
      allow delete: if isAdmin();
    }

    match /supplier_products/{supplierProductId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isAuthenticated();
    }

    match /purchase_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /purchase_request_items/{itemId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    match /purchase_orders/{purchaseOrderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /purchase_order_items/{itemId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    match /goods_receipts/{receiptId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /goods_receipt_items/{itemId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    match /procurement_audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /inventory_transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // STEP 17.4 — Supplier Performance Scorecard & Price Intelligence
    match /supplier_scorecard_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /supplier_performance_snapshots/{snapshotId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /supplier_price_alerts/{alertId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // STEP 17.5 — Smart Procurement Recommendations & Settings
    match /procurement_recommendations/{recId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /procurement_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ========================================================================
    // CASH FLOW & FINANCIAL CONTROL CENTER RULES
    // ========================================================================

    match /cash_flow_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /cash_flow_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ========================================================================
    // INVENTORY INTELLIGENCE & WAREHOUSE CONTROL RULES
    // ========================================================================

    match /inventory_intelligence_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /inventory_intelligence_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ========================================================================
    // EXECUTIVE BI & PROFITABILITY DASHBOARD RULES
    // ========================================================================

    match /executive_bi_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /bi_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

  }
}


